    "@react-router/node": "^7.7.1",
    "@react-router/serve": "^7.7.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.9.5",
    "@shopify/shopify-app-react-router": "^1.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^7.0.2",
    "bullmq": "^5.34.10",
    "ioredis": "^5.4.2",
    "isbot": "^5.1.0",
    "prisma": "^6.2.1",
