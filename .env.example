# Shopify app credentials — fill from your Partner dashboard before running `shopify app dev`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost
SCOPES=read_products,read_content,write_content

# Anthropic — Claude API key + model id used for llms.txt generation (PRD §6.6, §14).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Persistence — managed Postgres in production; local Postgres for dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llms_app?schema=public

# Background jobs (Phase 1) — bullmq + ioredis.
REDIS_URL=redis://localhost:6379

# Server-side session secret used by react-router cookies.
SESSION_SECRET=replace-me-with-a-32-byte-random-string

# Optional: pin a custom storefront domain when testing on a non-myshopify host.
# SHOP_CUSTOM_DOMAIN=
